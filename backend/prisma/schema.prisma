// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id        String @id @default(uuid())
  email     String    @unique
  firstName String
  lastName  String
  password  String
  loans     Loan[]
  createAt  DateTime  @default(now())
  updateAt  DateTime   @updatedAt
  deleteAt  DateTime?
}

model Asset {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  quantity    Int      @default(1) // Para bienes múltiples (ej. sillas, mesas)
  available   Int      @default(1) // Cantidad disponible para préstamo
  createdAt   DateTime @default(now())
  updateAt    DateTime   @updatedAt
  deleteAt    DateTime?
  loans       Loan[]
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  assets Asset[]
}

model Loan {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  quantity    Int
  loanDate    DateTime @default(now())
  dueDate     DateTime?               // 🛠 Renombrado para evitar confusión con `returnedAt` de `Return`
  returned    Boolean  @default(false) // 🛠 Indica si se devolvió todo
  fullName    String   
  dui         String   
  contact     String?  

  returns     Return[]                // 🛠 Relación para múltiples devoluciones

  @@unique([assetId, userId], name: "unique_loan")
}

model Return {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id])
  returnedAt  DateTime @default(now())
  quantity    Int      // 🛠 Cantidad devuelta
  notes       String?  // 🛠 Notas opcionales (daños, comentarios, etc.)
}