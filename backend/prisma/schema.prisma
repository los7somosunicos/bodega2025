// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id        String @id @default(uuid())
  email     String    @unique
  firstName String
  lastName  String
  password  String
  loans     Loan[]
  createAt  DateTime  @default(now())
  updateAt  DateTime   @updatedAt
  deleteAt  DateTime?
}

model Asset {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  quantity    Int      @default(1) // Para bienes múltiples (ej. sillas, mesas)
  available   Int      @default(1) // Cantidad disponible para préstamo
  createdAt   DateTime @default(now())
  updateAt    DateTime   @updatedAt
  deleteAt    DateTime?
  loans       Loan[]
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  assets Asset[]
  createAt  DateTime  @default(now())
  updateAt  DateTime   @updatedAt
  deleteAt  DateTime?
}

model Loan {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  quantity    Int      // Cantidad prestada
  loanDate    DateTime @default(now()) // Fecha de préstamo
  returned    Boolean  @default(false) // Indica si se ha devuelto todo
  returnedAt  DateTime? // Fecha de devolución
  fullName    String   // Nombre completo de la persona que recibe el préstamo
  dui         String   // Identificación (DUI) de la persona
  contact     String?  // Contacto de la persona
  notes       String?  // Notas sobre la devolución (ej. "2 sillas dañadas")
  @@unique([assetId, dui], name: "loan_asset_dui_unique")
}